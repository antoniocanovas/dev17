<odoo>
    <record id="res_partner_form_inherit_sscc_number" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_delivery_carrier_id']" position="after">
                <field name="sscc_qty"/>
            </xpath>

            <xpath expr="//notebook/page/group[@id='wisecap']" position="inside">
                <group name="bom_templates" string="BOM Templates" groups="mrp.group_mrp_manager">
                    <field name="mrp_bom_template_ids" colspan="2">
                        <tree editable="bottom">
                                <field name="name"/>
                                <field name="type"/>
                                <field name="box_template_id"/>
                            </tree>
                    </field>
                </group>
            </xpath>

        </field>
        <field name="priority">99</field>
    </record>

</odoo>
