<odoo>
    <record id="view_picking_form_custom" model="ir.ui.view">
        <field name="name">stock.picking.form.custom.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Inserta el botón después del botón con name 'print_return_label' -->
            <xpath expr="//header/button[@name='print_return_label']" position="after">
                <button name="add_sscc"
                        string="Añadir SSCC"
                        type="object"
                        class="oe_highlight"
                        groups="base.group_user"
                        icon="fa-refresh"
                        confirm="This will generate a new SSCC code if it is not already set."/>
            </xpath>
            <!-- El empaquetado es incompatible con el cliente: -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="incompatible_bom_template" invisible="1"/>
            </xpath>

            <!-- Mensajes de aviso y bloqueo por empaquetado no compatible con el cliente:  -->
            <xpath expr="//header" position="after">
                <div class="alert alert-danger mb-0" role="alert" invisible="not incompatible_bom_template">
                    Revisa los empaquetados de los productos reservados, son incompatibles con el cliente.
                </div>
            </xpath>

        </field>
    </record>
</odoo>
