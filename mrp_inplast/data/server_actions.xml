<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Actualización de percent para BOM LINE por Base automation, debido a que el write heredado no
    permitía guardar las contidades al depender del formulario del BOM -->
    <record id="ba_bom_percent_update" model="base.automation">
        <field name="name">=> BA BOM percent update</field>
        <field name="model_id" ref="mrp_inplast.model_mrp_bom"/>
        <field name="trigger">on_write</field>
        <field name="active" eval="True"/>
    </record>

    <record id="as_bom_percent_update" model="ir.actions.server">
        <field name="name">=> AS BOM percent update</field>
        <field name="model_id" ref="mrp_inplast.model_mrp_bom"/>
        <field name="state">code</field>
        <field name="code">
            record.bom_percent_update()
        </field>
        <field name="base_automation_id" ref="mrp_inplast.ba_bom_percent_update"/>
    </record>

    <!-- Actualización del nombre del color del producto en base a colorantes en BOM: -->
    <record id="ba_bom_product_color_and_raw_update" model="base.automation">
        <field name="name">=> BA BOM product color update</field>
        <field name="model_id" ref="mrp_inplast.model_mrp_bom"/>
        <field name="trigger">on_write</field>
        <field name="active" eval="True"/>
    </record>

    <record id="as_bom_product_color_and_raw_update" model="ir.actions.server">
        <field name="name">=> AS BOM product color update</field>
        <field name="model_id" ref="mrp_inplast.model_mrp_bom"/>
        <field name="state">code</field>
        <field name="code">
            record.bom_product_color_and_raw_update()
        </field>
        <field name="base_automation_id" ref="mrp_inplast.ba_bom_product_color_and_raw_update"/>
    </record>

    <record id="action_recalculate_tool_ppm" model="ir.actions.server">
        <field name="name">=> Recalcular Ciclos y Piezas</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
for product in records:
    for tool in product.mrp_tool_ids:
        ppm = 0
        if tool.pnt_tool_id and tool.pnt_cps:
            ppm = (tool.pnt_tool_id.pnt_hole_count * 60) / tool.pnt_cps
        tool.write({'pnt_ppm': ppm})
        </field>
    </record>
</odoo>
