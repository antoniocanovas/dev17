<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_pallet2pack_button" model="ir.ui.view">
        <field name="name">stock.picking.pallet2pack.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_validate']" position="before">
                <button name="action_pallet2pack"
                        type="object"
                        string="Pallet2Pack"
                        invisible="state in ('draft', 'done', 'cancel')"
                        class="btn-secondary"
                        groups="stock.group_stock_user"/>
            </xpath>
        </field>
    </record>

</odoo>
