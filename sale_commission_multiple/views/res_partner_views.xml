<odoo>
    <record id="referrer_plan_partner_inh_form" model="ir.ui.view">
        <field name="name">referrer.plan.partner.inh.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']/group" position="inside">
                <group name="multiple_commissions" string="Referrers">
                    <field name="referrer_plan_ids" nolabel="1" colspan="2" context="{'default_partner_id':id}">
                            <tree editable="1">
                                <field name="partner_id" column_invisible="1"/>
                                <field name="referrer_id" required="1"/>
                                <field name="commission_plan_id" required="1" readonly="0"/>
                            </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
