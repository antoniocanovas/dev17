<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="referrers_plan_sale_order_inh_form" model="ir.ui.view">
        <field name="name">referres.plan.sale.order.inh.form</field>
        <field name="model">sale.order</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="multiple_commissions" string="Referrers">
                    <field name="referrer_plan_ids" readonly="0" nolabel="1" colspan="4" context="{'default_sale_id':id, 'default_partner_id':partner_id}">
                        <tree editable="1">
                            <field name="sale_id" column_invisible="1"/>
                            <field name="partner_id" column_invisible="1"/>
                            <field name="referrer_id" required="1"/>
                            <field name="commission_plan_id" required="1" readonly="0"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>


    <record id="referrers_partner_commission_so_inh_form" model="ir.ui.view">
        <field name="name">referrers.partner.commission.so.inh.form</field>
        <field name="model">sale.order</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="partner_commission.sale_order_form_quote_inherit_partner_commission"/>
        <field name="mode">extension</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='referrer_id']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
                <xpath expr="//field[@name='referrer_id']" position="after">
                    <field name="referrer_plan_view_ids" widget="many2many_tags"/>
                </xpath>
            </data>
        </field>
        <field name="priority">100</field>
    </record>

</odoo>
