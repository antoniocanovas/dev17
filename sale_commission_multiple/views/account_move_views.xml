<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="referrer_plan_invoice_inh_form" model="ir.ui.view">
        <field name="name">referrer.plan.invoice.inh.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="multiple_commissions" string="Referrers">
                    <field name="referrer_plan_ids" readonly="0" nolabel="1" colspan="4" context="{'default_sale_id':id, 'default_partner_id':partner_id}">
                            <tree editable="1">
                                <field name="invoice_id" column_invisible="1"/>
                                <field name="partner_id" column_invisible="1"/>
                                <field name="referrer_id" required="1"/>
                                <field name="commission_plan_id" required="1" readonly="0"/>
                            </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="referrers_partner_commission_invoice_inh_form" model="ir.ui.view">
        <field name="name">referrers.partner.commission.invoice.inh.form</field>
        <field name="model">account.move</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="partner_commission.view_move_form_inherit_partner_commission"/>
        <field name="mode">extension</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='referrer_id']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
            </data>
        </field>
        <field name="priority">100</field>
    </record>

</odoo>