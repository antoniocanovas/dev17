<odoo>
     <!-- Herencia de la vista de búsqueda de sale.report (Análisis de Ventas) -->
    <record id="view_order_product_search_inherit" model="ir.ui.view">
        <field name="name">sale.report.search.inherit</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <!-- Añadir filtro después de los filtros principales -->
            <filter name="filter_date" position="before">
                <filter string="Filtra IPNR"
                        name="without_ipnr"
                        domain="[('product_id', '!=', %(l10n_es_ipnr_account.aportacion_ipnr_product_template)d)]"
                        help="Productos que no contienen IPNR en nombre o código"/>
                <separator/>
            </filter>
        </field>
    </record>

    <!-- OPCIÓN 1: Herencia del action principal de Análisis de Ventas -->
    <record id="sale.action_order_report_all" model="ir.actions.act_window">
        <field name="context" eval="{'search_default_Sales': 1, 'group_by_no_leaf': 1, 'group_by': [], 'search_default_filter_order_date': 1, 'search_default_recurring': 0, 'search_default_non_recurring': 1, 'search_default_without_ipnr': 1}"/>
    </record>

    <!-- OPCIÓN 2: Herencia del action de Análisis por Vendedor -->
    <record id="sale.action_order_report_salesperson" model="ir.actions.act_window">
        <field name="context" eval="{'search_default_User': 1, 'group_by': 'user_id', 'search_default_filter_order_date': 1, 'search_default_without_ipnr': 1}"/>
    </record>

    <!-- OPCIÓN 3: Herencia del action de Análisis por Productos -->
    <record id="sale.action_order_report_products" model="ir.actions.act_window">
        <field name="context" eval="{'search_default_Sales': 1, 'search_default_Product': 1, 'group_by_no_leaf': 1, 'group_by': 'product_id', 'search_default_filter_order_date': 1, 'search_default_without_ipnr': 1}"/>
    </record>

    <!-- OPCIÓN 4: Herencia del action de Análisis por Clientes -->
    <record id="sale.action_order_report_customers" model="ir.actions.act_window">
        <field name="context" eval="{'search_default_Customer': 1, 'group_by': 'partner_id', 'search_default_filter_order_date': 1, 'search_default_without_ipnr': 1}"/>
    </record>

</odoo>
