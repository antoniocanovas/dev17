<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- VISTAS DE BÚSQUEDA: -->
    <record id="fsc_attribute_product_inh_search" model="ir.ui.view">
        <field name="name">fsc.attribute.product.inh.search</field>
        <field name="model">product.product</field>
        <field name="type">search</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <data>
                <field name="all_product_tag_ids" position="before">
                    <field name="fsc_dimension_value_id"/>
                    <field name="fsc_quality_value_id"/>
                </field>
                <filter name="combo" position="after">
                    <separator/>
                    <filter string="Dimensions" name="with_dimension" domain="[('fsc_dimension_value_id','!=',False)]"/>
                    <filter string="Qualities" name="with_quality" domain="[('fsc_quality_value_id','!=',False)]"/>
                    <separator/>
                </filter>
                <xpath expr="//filter[@name='group_by_product_tmpl_id']" position="after">
                    <filter string="Dimension" name="fsc_dimension" context="{'group_by':'fsc_dimension_value_id'}"/>
                    <filter string="Quality" name="fsc_quality" context="{'group_by':'fsc_quality_value_id'}"/>
                </xpath>
            </data>
        </field>
    </record>

</odoo>

