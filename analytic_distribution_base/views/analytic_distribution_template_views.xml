<?xml version="1.0"?>
<odoo>

    <!-- WINDOW ACTIONS analytic.distribution.template Model: -->
    <record model="ir.actions.act_window" id="analytic_distribution_template_action_window" >
        <field name="name">Analytic Distribution templates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="domain" eval="False"/>
        <field name="filter" eval="False"/>
        <field name="limit">80</field>
        <field name="res_model">analytic.distribution.template</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" eval="False"/>
        <field name="target">current</field>
    </record>

    <!-- WINDOW ACTION o2m buttom to analytic lines: -->
    <record id="action_view_analytic_lines" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="context">{'search_default_analytic_distribution_template_id': active_id,'default_analytic_distribution_template_id': active_id}</field>
        <field name="domain">[('analytic_distribution_template_id', '=', active_id)]</field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="help"><![CDATA[<p>Analytic lines</p>]]></field>
        <field name="limit">80</field>
        <field name="name">Analytic lines</field>
        <field name="res_model">account.analytic.line</field>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="usage" eval="False"/>
    </record>


    <!-- MENU: -->
    <record id="analytic_distribution_template_menu" model="ir.ui.menu">
        <field name="action" ref="analytic_distribution_template_action_window"/>
        <field name="active" eval="True"/>
        <field name="name">Analytic distribution templates</field>
        <field name="parent_id" ref="account.menu_analytic_accounting"/>
        <field name="sequence">110</field>
        <field name="web_icon" eval="False"/>
    </record>

    <!-- FORM VIEW: -->
    <record id="analytic_distribution_template_default_form" model="ir.ui.view">
        <field name="name">analytic.distribution.template.default.form</field>
        <field name="model">analytic.distribution.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-spinner" type="action" invisible="not analytic_line_count"
                                name="%(analytic_distribution_template_action_window)d">
                            <field widget="statinfo" name="analytic_line_count" string="Lines"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Analytic distribution template name ..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="compute_method" required="1"/>
                        <field name="comment" placeholder="Notes" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page name="accounting" string="Accounting">
                            <group>
                                <group string="Income accounts">
                                    <field name="income_analytic_ids" widget="many2many_tags"/>
                                    <field name="income_account_ids" nolabel="1" colspan="2">
                                        <tree>
                                            <field name="code"/>
                                            <field name="name"/>
                                        </tree>
                                    </field>
                                </group>
                                <group string="Expense accounts">
                                    <field name="expense_analytic_ids" widget="many2many_tags"/>
                                    <field name="expense_account_ids" nolabel="1" colspan="2">
                                        <tree>
                                            <field name="code"/>
                                            <field name="name"/>
                                        </tree>
                                    </field>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" options="{'post_refresh': 'always'}"/>
                </div>

            </form>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">form</field>
    </record>

    <!-- TREE VIEW: -->
    <record id="analytic_distribution_template_default_tree" model="ir.ui.view">
        <field name="name">analytic.distribution.template.default.tree</field>
        <field name="model">analytic.distribution.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="compute_method"/>
            </tree>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">tree</field>
    </record>


</odoo>