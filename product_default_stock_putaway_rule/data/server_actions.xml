<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="ba_create_default_product_stock_putaway_rule" model="base.automation">
        <field name="name">=> Crea la regla de stock para cada producto</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="trigger">on_create_or_write</field>
        <field name="active" eval="True"/>
    </record>

    <record id="as_create_default_product_stock_rule" model="ir.actions.server">
        <field name="name">=> AS Crea la regla de stock para cada producto</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="evaluation_type">value</field>
        <field name="state">code</field>
        <field name="code">
            record.create_default_product_stock_putaway_rule()
        </field>
        <field name="base_automation_id" ref="ba_create_default_product_stock_putaway_rule"/>
    </record>

</odoo>
