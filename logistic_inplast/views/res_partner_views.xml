<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    # container_types per partner:
    <record id="logistic_inplast_res_partner_form" model="ir.ui.view">
        <field name="name">logistic.inplast.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//notebook" position="inside">
                    <page string="Containing types">
                        <group>
                            <field name="container_id"/>
                            <field name="container_ids" domain="[('id','!=', container_id)]"/>
                        </group>
                    </page>
                </xpath>

            </data>
        </field>
        <field name="priority">99</field>
        <field name="type">form</field>
    </record>

</odoo>