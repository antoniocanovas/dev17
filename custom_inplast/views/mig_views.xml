<odoo>
    <data>

        <record id="migration_hr_employee_inh_form" model="ir.ui.view">
            <field name="name">migration.hr.employee.inh.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='hr_settings']" position="after">
                    <page string="_migración" name="migration">
                        <group name="first" position="after">
                            <group>
                                <field name="mig_cuenta_bancaria"/>
                                <field name="mig_fecha_alta"/>
                                <field name="mig_tarjeta"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
            <field name="priority">99</field>
            <field name="type">form</field>
        </record>

        <record id="inplast_pricelist_mig_inh_view" model="ir.ui.view">
            <field name="name">inplast.pricelist.mig.inh.view</field>
            <field name="model">product.pricelist</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="product.product_pricelist_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='active']" position="after">
                    <field name="mig_codigocliente"/>
                </xpath>
            </field>
            <field name="priority">99</field>
        </record>

        <record id="mig_inventario_default_tree" model="ir.ui.view">
            <field name="active" eval="True"/>
            <field name="arch" type="xml">
                <tree string="MIG Inventario">
                    <field name="name"/>
                    <field name="qty"/>
                    <field name="ubicacion" optional="hide" groups="base.group_no_one"/>
                    <field name="ubicacion_old" optional="hide" groups="base.group_no_one"/>
                    <field name="lote" optional="show"/>
                    <field name="palet" optional="show"/>
                    <field name="sscc1" optional="show"/>
                    <field name="sscc2" optional="show"/>
                    <field name="boxsn" optional="show"/>
                    <field name="product_id"/>
                    <field name="lot_id"/>
                    <field name="location_id" optional="hide" groups="base.group_no_one"/>
                    <field name="sml_id" optional="hide"/>
                    <field name="mig_fechafabricacion" optional="show"/>
                    <field name="active" optional="hide"/>
                </tree>
            </field>
            <field name="groups_id" eval="[(6, 0, [])]"/>
            <field name="inherit_id" eval="False"/>
            <field name="key" eval="False"/>
            <field name="mode">primary</field>
            <field name="model">mig.inventario</field>
            <field name="name">Default tree view for MIG Inventario</field>
            <field name="priority">16</field>
            <field name="type">tree</field>
        </record>


