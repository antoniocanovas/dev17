<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VISTA TREE PERSONALIZADA PARA STOCK QUANT CON FECHA IN_DATE -->
    <record id="stock_quant_tree_view_custom" model="ir.ui.view">
        <field name="name">stock.quant.tree.custom</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <tree string="Stock Quants" create="false" edit="false">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="lot_id"/>
                <field name="lot_fabrication_date" string="Fecha Fabricación"/>
                <field name="in_date"/>
                <field name="quantity"/>
                <field name="available_quantity"/>
                <field name="package_id" groups="stock.group_tracking_lot"/>
                <field name="owner_id" groups="stock.group_tracking_owner"/>
            </tree>
        </field>
    </record>

    <!-- WINDOW ACTIONS: -->
    <record id="action_mig_inventario" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="domain" eval="False"/>
        <field name="filter" eval="False"/>
        <field name="limit">80</field>
        <field name="name">MIG Inventario</field>
        <field name="res_model">mig.inventario</field>
        <field name="search_view_id" eval="False"/>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="usage" eval="False"/>
        <field name="view_id" eval="False"/>
        <field name="view_mode">tree,form</field>
    </record>

