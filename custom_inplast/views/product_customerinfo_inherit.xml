<odoo>
    <record id="view_product_customerinfo_form_partner_domain" model="ir.ui.view">
        <field name="name">product.customerinfo.form.partner.domain</field>
        <field name="model">product.customerinfo</field>
        <!-- THIS IS WRONG: -->
        <field name="inherit_id"
               ref="product_supplierinfo_for_customer.product_customerinfo_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_company','=',True)]</attribute>
            </xpath>
        </field>
    </record>

</odoo>
