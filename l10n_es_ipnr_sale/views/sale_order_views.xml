    <record id="l10n_es_ipnr_sale_view_order_form" model="ir.ui.view">
        <field name="name">l10n.es.ipnr.sale.view.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="ipnr_company" invisible="1" />
                <field
                    name="is_ipnr"
                    readonly="state != 'draft'"
                    groups="base.group_no_one"
                    invisible="1"
                />
                    <!-- CAMBIADO POR GROUPS 02/2026: invisible="ipnr_company  == False" -->
            </field>
            <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="after">
                <field name="is_ipnr" optional="show"/>
            </xpath>
        </field>
    </record>

        <!-- Herencia de la vista de búsqueda de sale.order.line -->
    <record id="view_sales_order_line_filter_inherit" model="ir.ui.view">
        <field name="name">sale.order.line.select.inherit</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_sales_order_line_filter"/>
        <field name="arch" type="xml">
            <!-- Añadir filtro después del filtro "My Sales Order Lines" -->
            <filter name="my_sales_order_lines" position="after">
                <filter string="Filtrar IPNR"
                        name="without_ipnr"
                        domain="[('product_id', '!=', %(l10n_es_ipnr_account.aportacion_ipnr_product_template)d)]"
                        help="Productos que no contienen IPNR en el nombre"/>
            </filter>
        </field>
    </record>

      <record id="sale_order_line_menu.action_orders_lines" model="ir.actions.act_window">
        <field name="context">{'search_default_without_ipnr': 1}</field>
    </record>
</odoo>
