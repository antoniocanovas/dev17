<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    # Datos para recálculo de tarifas:
    <record id="inplast_product_category_inh_form" model="ir.ui.view">
        <field name="name">inplast.product.category.inh.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="account.view_category_property_form"/>
        <field name="arch" type="xml">
            <data>
                <group name="account_property" position="inside">
                    <group name="pricelist" string="Pricelist data">
                        <!--<field name="pnt_raw_material"/>-->
                        <field name="pnt_mrp_fault_percent"/>
                        <field name="pnt_i0"/>
                        <field name="pnt_i1"/>
                        <field name="pnt_i2"/>
                        <field name="pnt_i3"/>
                    </group>
                </group>
            </data>
        </field>
        <field name="priority">99</field>
        <field name="type">form</field>
    </record>

    <record id="inplast_product_category_inh_tree" model="ir.ui.view">
        <field name="name">inplast.product.category.inh.tree</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//tree[1]" position="attributes">
                    <attribute name="multi_edit">true</attribute>
                </xpath>
                <field name="display_name" position="after">
                    <field name="pnt_mrp_fault_percent"/>
                    <field name="pnt_i0"/>
                    <field name="pnt_i1"/>
                    <field name="pnt_i2"/>
                    <field name="pnt_i3"/>
                </field>
            </data>
        </field>
    </record>

</odoo>
