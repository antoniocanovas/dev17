<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="ba_update_packing_prices_from_base_product" model="base.automation">
        <field name="name">=> Actualiza precios de PACKING al cambiar el de producto base</field>
        <field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="trigger">on_create_or_write</field>
        <field name="active" eval="True"/>
    </record>

    <record id="as_update_packing_prices_from_base_product" model="ir.actions.server">
        <field name="name">=> AS Actualiza precios de PACKING al cambiar el de producto base</field>
        <field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="evaluation_type">value</field>
        <field name="state">code</field>
        <field name="code">
            record.update_packing_products_price()
        </field>
        <field name="base_automation_id" ref="sale_inplast.ba_update_packing_prices_from_base_product"/>
    </record>

</odoo>
