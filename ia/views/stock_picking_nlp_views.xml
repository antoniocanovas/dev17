<odoo>
    <record id="view_stock_picking_nlp_form" model="ir.ui.view">
        <field name="name">stock.picking.nlp.form</field>
        <field name="model">stock.picking.nlp</field>
        <field name="arch" type="xml">
            <form string="Procesador NLP para Entregas">
                <sheet>
                    <group>
                        <field name="OPENAI_API_KEY" />
                        <field name="question" placeholder="Escribe tu pregunta aquí..."/>
                        <field name="response" readonly="1"/>
                    </group>

                    <button string="Enviar Pregunta"
                            type="object"
                            name="action_process_question"
                            class="oe_highlight"/>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_picking_nlp_tree" model="ir.ui.view">
        <field name="name">stock.picking.nlp.tree</field>
        <field name="model">stock.picking.nlp</field>
        <field name="arch" type="xml">
            <tree string="Procesador NLP">
                <field name="question"/>
                <field name="response"/>


            </tree>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_stock_picking_nlp" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="domain" eval="False"/>
        <field name="filter" eval="False"/>
        <field name="limit">80</field>
        <field name="name">Procesador NLP</field>
        <field name="res_model">stock.picking.nlp</field>
        <field name="search_view_id" eval="False"/>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="usage" eval="False"/>
        <field name="view_id" eval="False"/>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="pruebas_stock_menu" model="ir.ui.menu">
        <field name="active" eval="True"/>
        <field name="name">ia</field>
        <field name="parent_id" ref="stock.menu_stock_config_settings"/>
        <field name="sequence">100</field>
        <field name="web_icon" eval="False"/>
    </record>

    <!-- MENU ITEM -->
    <record id="stock_picking_nlp_menu" model="ir.ui.menu">
        <field name="action" ref="action_stock_picking_nlp"/>
        <field name="active" eval="True"/>
        <field name="parent_id" ref="ia.pruebas_stock_menu"/>
        <field name="name">Procesador NLP</field>
        <field name="sequence">100</field>
        <field name="web_icon" eval="False"/>
    </record>
</odoo>
