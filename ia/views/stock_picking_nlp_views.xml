<odoo>
    <record id="menu_stock_picking_nlp" model="ir.ui.menu">
        <field name="name">Procesador NLP</field>
        <field name="sequence">10</field>
        <field name="web_icon">fa-magic</field>
    </record>

    <!-- SUBMENÚ CONFIGURACIÓN -->
    <record id="menu_stock_picking_nlp_config" model="ir.ui.menu">
        <field name="name">Configuración</field>
        <field name="parent_id" ref="menu_stock_picking_nlp"/>
        <field name="sequence">20</field>
    </record>

    <!-- CONFIGURACIÓN DEL PROCESADOR NLP -->
    <record id="view_stock_picking_nlp_form" model="ir.ui.view">
        <field name="name">stock.picking.nlp.form</field>
        <field name="model">stock.picking.nlp</field>
        <field name="arch" type="xml">
            <form string="Procesador NLP para Entregas">
                <sheet>
                    <group>
                        <field name="question" placeholder="Escribe tu pregunta aquí..."/>
                        <field name="response" readonly="1"/>
                    </group>
                    <button string="Enviar Pregunta"
                            type="object"
                            name="action_process_question"
                            class="oe_highlight"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_picking_nlp_tree" model="ir.ui.view">
        <field name="name">stock.picking.nlp.tree</field>
        <field name="model">stock.picking.nlp</field>
        <field name="arch" type="xml">
            <tree string="Procesador NLP">
                <field name="question"/>
                <field name="response"/>
            </tree>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="action_stock_picking_nlp" model="ir.actions.act_window">
        <field name="name">Procesador NLP</field>
        <field name="res_model">stock.picking.nlp</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>

    <!-- MENÚ EN CONFIGURACIÓN -->
    <record id="menu_stock_picking_nlp_action" model="ir.ui.menu">
        <field name="name">Procesador NLP</field>
        <field name="action" ref="action_stock_picking_nlp"/>
        <field name="parent_id" ref="menu_stock_picking_nlp_config"/>
        <field name="sequence">30</field>
    </record>
</odoo>
