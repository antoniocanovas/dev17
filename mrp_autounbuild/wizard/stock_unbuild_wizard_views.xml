<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock_unbuild_wizard_form_view" model="ir.ui.view">
            <field name="name">stock.unbuild.wizard.form</field>
            <field name="model">stock.unbuild.wizard</field>
            <field name="arch" type="xml">
                <form string="Unbuild Product">
                    <group>
                        <field name="product_id"/>
                        <field name="lot_id"/>
                        <field name="location_id"/>
                        <field name="bom_id" invisible="1"/>
                        <field name="mo_id" readonly="1" force_save="1"/>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
