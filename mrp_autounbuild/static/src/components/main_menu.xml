<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="stock_barcode.MainMenu" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_main_menu_buttons')]" position="inside">
            <div class="col">
                <button class="btn btn-block btn-primary mb-4 w-100" t-on-click="() => this.openUnbuild()">
                    Unbuild
                </button>
            </div>
        </xpath>
    </t>
</templates>
