<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_autounbuild.UnbuildBarcodeHandler" owl="1">
        <div class="o_barcode_client_action">
            <div class="o_header">
                <h4>Unbuild from Lot/Serial</h4>
                <p class="text-muted">Scan or type a Lot/Serial Number to unbuild the product.</p>
            </div>
            <div class="o_content p-3">
                <div class="input-group mb-3">
                    <input
                        type="text"
                        class="o_barcode_manualentry form-control"
                        placeholder="Lot / Serial number..."
                        t-model="state.input_value"
                        t-on-keydown="onKeydown"
                        autofocus="true"
                    />
                    <button class="btn btn-primary" t-on-click="onManualConfirm">
                        Unbuild
                    </button>
                </div>
                <p t-if="state.lot_name" class="text-success">
                    Last processed: <strong t-esc="state.lot_name"/>
                </p>
            </div>
            <div class="o_barcode_generic_bottom_buttons">
                <button class="btn btn-secondary o_close" t-on-click="() => this.actionService.doAction({type: 'ir.actions.act_window_close'})">
                    Close
                </button>
            </div>
        </div>
    </t>
</templates>
