<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- ACCION DE VENTANA: -->
    <record id="action_eutr_audit" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="filter" eval="False"/>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="limit">80</field>
        <field name="name">EUTR Auditories</field>
        <field name="res_model">eutr.audit</field>
        <field name="search_view_id" eval="False"/>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- CONFIG MENU: -->
    <record id="eutr_audit_menu" model="ir.ui.menu">
        <field name="action" ref="action_eutr_audit"/>
        <field name="active" eval="True"/>
        <field name="name">EUTR Auditories</field>
        <field name="parent_id" ref="stock.menu_warehouse_report"/>
        <field name="sequence">210</field>
        <field name="web_icon" eval="False"/>
        <field name="groups_id" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
    </record>


    <!-- FORM VIEW: -->
    <record id="eutr_audit_default_form" model="ir.ui.view">
        <field name="name">eutr.audit.default.form</field>
        <field name="model">eutr.audit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                    <button name="compute_eutr_audit"
                            icon="fa-delicious" class="oe_stat_button"
                            type="object" string="Compute"
                            invisible="state in ['done','cancel']"
                    >
                    </button>
                </header>
                <sheet>
                    <h1>
                        <field name="name" required="1" placeholder="e.g. Audit #..." />
                    </h1>
                    <group>
                        <group>
                            <field name="date_from" required="1" readonly="state in ['done']"/>
                            <field name="date_to" required="1" readonly="state in ['done']"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <tree>
                            <field name="product_id"/>
                            <field name="eutr_nc_code"/>
                            <field name="name"/>
                            <field name="volume"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                            <field name="eutr_cdc"/>
                            <field name="eutr_cl"/>
                            <field name="intrastat_code_id" optional="hide"/>
                            <field name="eutr_audit_id" column_invisible="1"/>
                        </tree>
                    </field>
                    <group string="Notes">
                        <field name="notes" placeholder="Audit details and notes..." nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">form</field>
    </record>

    <!-- list VIEW: -->
    <record id="eutr_audit_default_list" model="ir.ui.view">
        <field name="name">eutr.audit.default.list</field>
        <field name="model">eutr.audit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
            </tree>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">tree</field>
    </record>

</odoo>
