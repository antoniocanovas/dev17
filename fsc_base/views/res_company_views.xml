<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fsc_base_res_company_inh_form" model="ir.ui.view">
        <field name="name">fsc.base.res.company.inh.form</field>
        <field name="model">res.company</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="fsc" string="FSC">
                    <group>
                        <group name="fsc_attributes">
                            <field name="fsc_format_attribute_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
