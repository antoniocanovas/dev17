    <record id="l10n_es_ipnr_account_view_company_form" model="ir.ui.view">
        <field name="name">l10n.es.ipnr.account.view.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="ipnr" string="IPNR">
                    <!-- ========================================= -->
                    <!-- SECCIÓN 1: Configuración General -->
                    <!-- ========================================= -->
                    <group name="ipnr_general_config" string="Configuración General">
                        <group>
                            <field name="ipnr_enable"/>
                            <field name="ipnr_date_from" invisible="ipnr_enable == False" required="ipnr_enable == True"/>
                            <field name="plastic_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group>
                            <field name="company_plastic_acquirer" string="Adquiriente" invisible="ipnr_enable == False" required="ipnr_enable == True"/>
                            <field name="company_plastic_manufacturer" string="Fabricante" invisible="ipnr_enable == False" required="ipnr_enable == True"/>
                            <field name="ipnr_show_in_reports" string="Imprimir en líneas" invisible="ipnr_enable == False"/>
                        </group>
                    </group>

                    <!-- ========================================= -->
                    <!-- SECCIÓN 2: Configuración Contable -->
                    <!-- ========================================= -->
                    <group name="ipnr_accounting_config" string="Configuración Contable" invisible="not ipnr_enable">
                        <group>
                            <field name="plastic_journal_id" invisible="ipnr_enable == False" required="ipnr_enable == True" string="Diario IPNR"/>
                            <field name="plastic_acquirer_account_id" invisible="ipnr_enable == False" required="ipnr_enable == True" string="Cuenta adquisición"/>
                            <field name="plastic_manufacture_account_id" invisible="ipnr_enable == False" required="ipnr_enable == True" string="Cuenta fabricación"/>
                        </group>
                        <group>
                            <field name="ipnr_consolidate_lines" string="Consolidar líneas" invisible="ipnr_enable == False" widget="boolean_toggle"/>
                            <field name="auto_validate_ipnr_purchase" invisible="ipnr_enable == False" widget="boolean_toggle" string="Autovalidar compras"/>
                            <field name="auto_validate_ipnr_sale" invisible="ipnr_enable == False" widget="boolean_toggle" string="Autovalidar ventas"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
