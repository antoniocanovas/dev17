<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Partner customization & migration fields : -->
    <record id="ipnr_res_partner_inh_form" model="ir.ui.view">
        <field name="name">ipnr.res.partner.inh.form</field>
        <field name="model">res.partner</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/div[1]/field[@name='state_id']" position="attributes">
                <attribute name="required">country_code == "ES"</attribute>
            </xpath>
            <xpath expr="//field[@name='industry_id']" position="after">
                <field name="ipnr_tax_zone"/>
            </xpath>
        </field>
        <field name="priority">99</field>
    </record>

</odoo>
