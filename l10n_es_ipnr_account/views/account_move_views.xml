    <record id="l10n_es_ipnr_account_view_move_form" model="ir.ui.view">
        <field name="name">l10n.es.ipnr.account.view.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="ipnr_company" invisible="1" />
                <field
                    name="is_ipnr"
                    readonly="state != 'draft'"
                    invisible="ipnr_company == False or move_type not in ['out_invoice','out_refund','in_invoice','in_refund']"
                />
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/form//field[@name='price_unit']"
                position="before"
            >
                <field name="is_ipnr" invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/tree/field[@name='price_unit']"
                position="before"
            >
                <field name="is_ipnr" invisible="1" />
            </xpath>

            <!-- Apunte de compras/ventas para el impuesto al plástico: -->
            <xpath expr="//header" position="inside">
                <button name="create_plastic_tax_entry" type="object" data-hotkey="shift+r"
                        string="Plastic Tax entry" class="oe_highlight"
                        invisible="not plastic_tax or plastictax_move_id"/>
            </xpath>
            <xpath expr="//header" position="after">
                <div class="alert alert-info mb-0" role="alert" invisible="plastic_tax == False">
                    Esta operación requiere impuesto al plástico, pulse el botón "Crear apunte" para crearlo en modo borrador
                    y revísión posterior para confirmar, o elija uno creado previamente.
                </div>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="plastictax_move_id" invisible="move_type not in ('out_invoice', 'out_refund','in_invoice','in_refund')"/>
                <field name="plastic_tax" invisible="1"/>
            </xpath>

        </field>
    </record>
</odoo>
