    <record id="l10n_es_ipnr_account_product_template_form_view" model="ir.ui.view">
        <field name="name">l10n.es.sigaus.account.product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <field name="categ_id" position="before">
                <field name="ipnr_subject" />
                <field name="tax_plastic_type" required="ipnr_subject" invisible="ipnr_subject == 'no'" />
                <field name="plastic_tax_weight" required="ipnr_subject" invisible="ipnr_subject == 'no'" />
                <field name="plastic_weight_non_recyclable" required="ipnr_subject" invisible="ipnr_subject == 'no'" />

            </field>
        </field>
    </record>
</odoo>

