    <record id="action_set_tax_plastic_type_from_category" model="ir.actions.server">
        <field name="name">Set Plastic Type from Category</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">
for record in records:
    if record.categ_id and record.categ_id.tax_plastic_type:
        record.write({'tax_plastic_type': record.categ_id.tax_plastic_type})
        </field>
    </record>

</odoo>
