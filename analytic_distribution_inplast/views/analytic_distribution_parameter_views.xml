<?xml version="1.0"?>
<odoo>

    <!-- WINDOW ACTIONS analytic.distribution.parameter Model: -->
    <record model="ir.actions.act_window" id="analytic_distribution_parameter_action_window">
        <field name="name">Analytic Distribution Parameters</field>
        <field name="type">ir.actions.act_window</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="domain" eval="False"/>
        <field name="filter" eval="False"/>
        <field name="limit">80</field>
        <field name="res_model">analytic.distribution.parameter</field>
        <field name="view_mode">form</field>
        <field name="res_id">1</field>
        <field name="search_view_id" eval="False"/>
        <field name="target">current</field>
    </record>


    <!-- MENU: -->
    <record id="analytic_distribution_parameter_menu" model="ir.ui.menu">
        <field name="action" ref="analytic_distribution_parameter_action_window"/>
        <field name="active" eval="True"/>
        <field name="name">Analytic distribution parameters</field>
        <field name="parent_id" ref="account.menu_analytic_accounting"/>
        <field name="sequence">100</field>
        <field name="web_icon" eval="False"/>
    </record>

    <!-- FORM VIEW: -->
    <record id="analytic_distribution_template_default_form" model="ir.ui.view">
        <field name="name">analytic.distribution.parameter.default.form</field>
        <field name="model">analytic.distribution.parameter</field>
        <field name="arch" type="xml">
            <form create="0">
                 <sheet>
                    <group>
                        <field name="name" invisible="1"/>
                    </group>

                        <group >
                            <group string="Warehouse">
                                <field name="truck_load" widget="float_time"/>
                                <field name="container_load" widget="float_time"/>
                                <field name="picking_unload" widget="float_time"/>
                            </group>
                            <group string="Internal Transfer Relocation (h/day)">
                                <field name="raw_color_reloc_day" widget="float_time"/>
                                <field name="raw_pallet_reloc_day" widget="float_time"/>
                                <field name="raw_cboard_reloc_day" widget="float_time"/>
                                <field name="raw_bag_reloc_day" widget="float_time"/>
                            </group>
                        </group>

                        <group >
                            <group string="Raw Material Reception">
                                <field name="raw_cistern_unload" widget="float_time"/>
                                <field name="raw_sack_unload" widget="float_time"/>
                                <field name="raw_color_unload" widget="float_time"/>
                                <field name="raw_pallet_unload" widget="float_time"/>
                                <field name="raw_cardboard_unload" widget="float_time"/>
                                <field name="raw_bag_unload" widget="float_time"/>
                            </group>

                            <group string="Other">
                                <field name="pallet_reloc"/>
                                <field name="ctr_box_qty"/>
                            </group>
                        </group>

                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" options="{'post_refresh': 'always'}"/>
                </div>

            </form>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">form</field>
    </record>

</odoo>