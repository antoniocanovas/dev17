<?xml version="1.0"?>
<odoo>

    <!-- TREE VIEW -->
    <record id="mrp_production_legacy_tree" model="ir.ui.view">
        <field name="name">mrp.production.legacy.tree</field>
        <field name="model">mrp.production.legacy</field>
        <field name="arch" type="xml">
            <tree editable="bottom" multi_edit="1">
                <field name="machine_plan_id" column_invisible="1"/>
                <field name="date"/>
                <field name="machine_id"
                       domain="[('plan_id', '=', machine_plan_id)]"
                       options="{'no_create': True}"/>
                <field name="name"
                       domain="[('pnt_product_type', '=', 'packing')]"
                       options="{'no_create': True}"/>
                <field name="product_qty"/>
                <field name="parent_id" optional="hide"/>
                <field name="time" widget="float_time"/>
            </tree>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="mrp_production_legacy_search" model="ir.ui.view">
        <field name="name">mrp.production.legacy.search</field>
        <field name="model">mrp.production.legacy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="machine_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_product" string="Product"
                            context="{'group_by': 'parent_id'}"/>
                    <filter name="group_by_machine" string="Machine"
                            context="{'group_by': 'machine_id'}"/>
                    <filter name="group_by_product" string="Packing"
                            context="{'group_by': 'name'}"/>
                    <filter name="group_by_date" string="Date"
                            context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="mrp_production_legacy_action" model="ir.actions.act_window">
        <field name="name">MRP Legacy</field>
        <field name="res_model">mrp.production.legacy</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="mrp_production_legacy_tree"/>
        <field name="search_view_id" ref="mrp_production_legacy_search"/>
    </record>

    <!-- MENU under Manufacturing > Operations -->
    <menuitem
            id="mrp_production_legacy_menu"
            name="MRP Legacy"
            parent="mrp.menu_mrp_manufacturing"
            action="mrp_production_legacy_action"
            sequence="55"
            groups="mrp.group_mrp_user"/>

</odoo>
