<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="analytic_distribution_analytic_account_inh_form" model="ir.ui.view">
        <field name="name">account.analytic.account.inh.form</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <field name="plan_id" position="after">
                <field name="is_machine_plan" invisible="1"/>
                <field name="workcenter_id"
                       invisible="not is_machine_plan"
                       required="is_machine_plan"/>
            </field>
        </field>
    </record>

</odoo>