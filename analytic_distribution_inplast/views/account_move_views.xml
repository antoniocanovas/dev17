<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="analytic_distribution_inh_form" model="ir.ui.view">
        <field name="name">analytic.distribution.invoice.inh.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id']" position="after">
                    <field name="analytic_distribution_account_id" required="not display_type"
                           options="{'no_create':true}"
                           domain="[('plan_id','=',analytic_distribution_plan_id)]"/>
                    <field name="analytic_distribution_plan_id" column_invisible="1"/>
                </xpath>
                <xpath expr="//page[@name='aml_tab']/field[@name='line_ids']/tree[1]/field[@name='account_id']" position="after">
                    <field name="analytic_distribution_account_id" optional="show"/>
                </xpath>
            </data>
        </field>
    </record>

</odoo>