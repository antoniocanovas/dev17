<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="analytic_distribution_analytic_line_inh_list" model="ir.ui.view">
        <field name="name">analytic.distribution.analytic.line.inh.form</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_form"/>
        <field name="arch" type="xml">
            <data>
                <field name="date" position="after">
                    <field name="fixed_analytic_distribution" widget="boolean_toggle"/>
                    <field name="analytic_distribution_account_id"
                           options="{'no_create':true}"
                           domain="[('plan_id','=',analytic_distribution_plan_id)]"/>
                    <field name="workcenter_id"/>
                    <field name="analytic_distribution_plan_id" invisible="1"/>
                </field>
            </data>
        </field>
    </record>

    <record id="analytic_distribution_analytic_line_inh_tree" model="ir.ui.view">
        <field name="name">analytic.distribution.analytic.line.inh.tree</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
        <field name="arch" type="xml">
            <data>
                <field name="account_id" position="after">
                    <field name="fixed_analytic_distribution" widget="boolean_toggle"/>
                    <field name="workcenter_id" optional="hide"/>
                    <field name="analytic_distribution_account_id" optional="show"/>
                </field>
            </data>
        </field>
    </record>

</odoo>